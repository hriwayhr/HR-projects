# Вход: password — по почте (логину) и паролю из «Команды»; yandex — через корпоративный Яндекс ID
AUTH=password
# Адрес сервиса. Пусто — setup.sh возьмёт бесплатный адрес вида 1-2-3-4.sslip.io по IP сервера (HTTPS работает).
# Свой поддомен: A-запись на IP сервера, затем впишите его сюда и запустите setup.sh снова.
DOMAIN=
BASE_URL=
# Ключ подписи сессий — setup.sh создаёт сам; сменить = разлогинить всех
SESSION_SECRET=
# Сколько дней хранить ночные копии в data/backups
BACKUP_KEEP_DAYS=30
# Только для AUTH=yandex: домен корпоративной почты, ваша почта (первый администратор),
# ключи приложения на https://oauth.yandex.ru (Redirect URI: BASE_URL/api/callback)
ALLOWED_DOMAINS=
ADMIN_EMAILS=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Код на рабочую почту (портал, AUTH=password): при первом входе HR и администратора с нового устройства и при «Забыли пароль?».
# Пусто — вход только по паролю, восстановления по почте нет. Яндекс 360: ящик (например noreply@iway.ru) → Безопасность →
# Пароли приложений → «Почта»; этот пароль — в SMTP_PASS (не пароль от ящика). С сервера должен быть открыт исходящий порт 465.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
