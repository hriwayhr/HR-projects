# Адрес сервиса: поддомен, A-запись которого указывает на IP сервера
DOMAIN=hr.example.ru
BASE_URL=https://hr.example.ru
# Домен корпоративной почты (Яндекс 360) и ваша почта — первый администратор
ALLOWED_DOMAINS=example.ru
ADMIN_EMAILS=you@example.ru
# Из приложения на https://oauth.yandex.ru (Redirect URI: BASE_URL/api/callback)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Ключ подписи сессий — setup.sh создаёт сам; сменить = разлогинить всех
SESSION_SECRET=
# Сколько дней хранить ночные копии в data/backups
BACKUP_KEEP_DAYS=30
